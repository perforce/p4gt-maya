END

IDD_OLD_VERSION_DIALOG DIALOGEX 0, 0, 34000, 122
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
// CAPTION "P4GT - Get Latest Revision/Checkout"
CAPTION "P4GT - 最新リビジョンを取得/チェックアウト"
FONT 9, "ＭＳ ゴシック"
BEGIN
