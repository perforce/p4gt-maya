    CONTROL         "Always",IDC_CLOSING_ALWAYS_RADIO,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,30,132,102,10
    CONTROL         "Never",IDC_CLOSING_NEVER_RADIO,"Button",
                    BS_AUTORADIOBUTTON,30,144,90,10
    CONTROL         "Prompt",IDC_CLOSING_PROMPT_RADIO,"Button",
                    BS_AUTORADIOBUTTON,30,156,96,10
    LTEXT           "When closing a file:",IDC_STATIC,6,172,204,8
    CONTROL         "&Prompt to revert file from P4",
                    IDC_REVERT_ON_CLOSE_CHECK,"Button", BS_AUTOCHECKBOX |
                    WS_TABSTOP,30,184,144,10
    LTEXT           "When opening a file, update e&xternal file references:",
                    IDC_EXTERNAL_LABEL,6,202,222,8
    CONTROL         "Always",IDC_SYNC_ALWAYS_RADIO,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,30,214,84,10
    CONTROL         "Never",IDC_SYNC_NEVER_RADIO,"Button",BS_AUTORADIOBUTTON,
                    30,226,78,10
    CONTROL         "Prompt",IDC_SYNC_PROMPT_RADIO,"Button",
                    BS_AUTORADIOBUTTON,30,238,78,10
END

