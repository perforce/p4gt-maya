                    IDC_OTHER_DOCS_CHECK,"Button",BS_AUTOCHECKBOX |
                    WS_TABSTOP,30,132,144,10
    LTEXT           "Informational prompts:",IDC_STATIC,6,150,162,8
    CONTROL         "Display &confirmation dialogs (on add/check out)",
                    IDC_CONFIRM_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,
                    30,162,198,10
END

IDD_OPTIONS_PAGE2_DIALOG DIALOGEX 0, 0, 235, 251
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "When &opening a file, check out from P4:",
                    IDC_STATIC,7,7,221,8
    CONTROL         "Always",IDC_OPENING_ALWAYS_RADIO,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,30,18,78,10
    CONTROL         "Never",IDC_OPENING_NEVER_RADIO,"Button",
                    BS_AUTORADIOBUTTON,30,30,84,10
    CONTROL         "Prompt",IDC_OPENING_PROMPT_RADIO,"Button",
                    BS_AUTORADIOBUTTON,30,42,84,10
    LTEXT           "When &reopening a file, after undo (reverting), check out from P4:",
                    IDC_STATIC,6,60,222,18
    CONTROL         "Always",IDC_REOPENING_ALWAYS_RADIO,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,30,78,96,10
    CONTROL         "Never",IDC_REOPENING_NEVER_RADIO,"Button",
                    BS_AUTORADIOBUTTON,30,90,96,10
    CONTROL         "Prompt",IDC_REOPENING_PROMPT_RADIO,"Button",
                    BS_AUTORADIOBUTTON,30,102,102,10
